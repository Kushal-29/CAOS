# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Supabase / Render Postgres / local)
DATABASE_URL="postgresql://user:password@localhost:5432/caos?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Credential vault encryption (32-byte key, base64)
CREDENTIAL_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
